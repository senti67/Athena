# ATHENA Environment Variables (Alpaca Paper Trading Integration)

# Application
APP_ENV=development
APP_NAME=ATHENA
LOG_LEVEL=INFO
DEBUG=true
PORT=8000
HOST=0.0.0.0

# -------------------------------------------------------------
# ALPACA MARKETS TRADING API CONFIGURATION
# -------------------------------------------------------------
# Your Alpaca Paper Trading API Key ID & Secret from https://app.alpaca.markets
ALPACA_API_KEY=your_alpaca_api_key_id
ALPACA_SECRET_KEY=your_alpaca_api_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_PAPER=true
BROKER_PROVIDER=alpaca

# Execution Safety (Live trading disabled by default)
LIVE_TRADING_ENABLED=false
EXECUTION_MODE=PAPER
DEFAULT_CONFIDENCE_THRESHOLD=0.75
MIN_DATA_QUALITY_SCORE=0.80

# Risk Management Limits (USD)
MAX_DAILY_LOSS=5000.00
MAX_POSITION_SIZE=50000.00
MAX_PORTFOLIO_EXPOSURE=1.00
MAX_LEVERAGE=1.00
MAX_SECTOR_CONCENTRATION=0.30
MAX_SINGLE_ASSET_EXPOSURE=0.20
MAX_DRAWDOWN_LIMIT=0.15

# Security & Auth
JWT_SECRET_KEY=athena-institutional-super-secret-jwt-key-change-in-prod-2026!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Default: local SQLite; Production: PostgreSQL TimescaleDB)
DATABASE_URL=sqlite+aiosqlite:///./athena.db
DATABASE_SYNC_URL=sqlite:///./athena.db

# Cache & Messaging
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_USE_LOCAL_BUS=true

# AI Providers (Optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
LLM_DEFAULT_PROVIDER=mock
