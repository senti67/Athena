# ATHENA QUANTITATIVE PLATFORM CONFIGURATION

# Application Environment
APP_ENV=development
APP_NAME=ATHENA
LOG_LEVEL=INFO
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Execution & Safety Controls (RULE 3: Live trading disabled by default)
LIVE_TRADING_ENABLED=false
EXECUTION_MODE=PAPER
DEFAULT_CONFIDENCE_THRESHOLD=0.75
MIN_DATA_QUALITY_SCORE=0.80

# Risk Management Limits
MAX_DAILY_LOSS=5000.00
MAX_POSITION_SIZE=50000.00
MAX_PORTFOLIO_EXPOSURE=1.00
MAX_LEVERAGE=1.00
MAX_SECTOR_CONCENTRATION=0.25
MAX_SINGLE_ASSET_EXPOSURE=0.10
MAX_DRAWDOWN_LIMIT=0.15
VAR_95_LIMIT=0.03
CVAR_95_LIMIT=0.05
CIRCUIT_BREAKER_TRIGGERED=false

# Security & Authentication
JWT_SECRET_KEY=athena-institutional-super-secret-jwt-key-change-in-prod-2026!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
API_KEY_HEADER=X-Athena-API-Key

# Database (PostgreSQL + TimescaleDB + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/athena_db
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/athena_db
SQL_ECHO=false

# In-Memory Cache & State (Redis)
REDIS_URL=redis://localhost:6379/0

# Event Bus & Messaging (Kafka)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_USE_LOCAL_BUS=true

# AI / LLM Providers (Multi-Provider Abstraction)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
LLM_DEFAULT_PROVIDER=mock
LLM_PRIMARY_MODEL=gpt-4o
LLM_FALLBACK_MODEL=claude-3-5-sonnet-20241022
LLM_FAST_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=30

# Market Data Providers
MARKET_DATA_PROVIDER=mock
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
FMP_API_KEY=

# Broker Integrations (Adapters)
BROKER_PROVIDER=paper
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_BASE_URL=https://paper-api.alpaca.markets

# Paper Trading Simulation Parameters
PAPER_STARTING_CASH=100000.00
PAPER_SLIPPAGE_BPS=5.0
PAPER_COMMISSION_PER_SHARE=0.005
PAPER_LATENCY_MS=50

# Prometheus & Observability
PROMETHEUS_METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
